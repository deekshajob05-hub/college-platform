generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id         Int            @id @default(autoincrement())
  name       String
  location   String
  fees       Int
  rating     Float
  overview   String
  placements String
  courses    String
  createdAt  DateTime       @default(now())
  savedBy    SavedCollege[]
}

model User {
  id        Int            @id @default(autoincrement())
  email     String         @unique
  password  String
  createdAt DateTime       @default(now())
  saved     SavedCollege[]
}

model SavedCollege {
  id        Int     @id @default(autoincrement())
  userId    Int
  collegeId Int
  user      User    @relation(fields: [userId], references: [id])
  college   College @relation(fields: [collegeId], references: [id])
}