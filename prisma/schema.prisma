datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model College {
  id        String   @id @default(uuid())
  name      String
  location  String
  state     String
  stream    String
  cutoff    Float
  fees      Int
  rating    Float
  logo      String
  createdAt DateTime @default(now())
}
